# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-real-token

# Required for Vercel. Use the same random value here and in Vercel.
# Letters, numbers, underscores, and hyphens only (maximum 256 characters).
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Used only when running `npm.cmd run webhook:set` after a Vercel deployment.
# TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app/api/telegram

# Vercel's Upstash integration normally adds these automatically.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
# IMPOSTOR_REDIS_PREFIX=impostor:production

# Optional settings
MIN_PLAYERS=3
MAX_PLAYERS=12
DATA_FILE=.data/state.json
# WORDS_FILE=C:\path\to\custom-words.json
AUTO_SEND_ROLES_IF_ADMIN=true
POLL_TIMEOUT_SECONDS=25
# TELEGRAM_API_BASE_URL=https://api.telegram.org
