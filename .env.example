# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-real-token

# Optional settings
MIN_PLAYERS=3
MAX_PLAYERS=12
DATA_FILE=.data/state.json
# WORDS_FILE=C:\path\to\custom-words.json
AUTO_SEND_ROLES_IF_ADMIN=true
POLL_TIMEOUT_SECONDS=25
# TELEGRAM_API_BASE_URL=https://api.telegram.org
